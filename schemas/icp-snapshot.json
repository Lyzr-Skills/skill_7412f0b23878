{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ICPSnapshotSchema",
  "type": "object",
  "properties": {
    "snapshot_id": { "type": "string" },
    "captured_at": { "type": "string", "format": "date-time" },
    "icp_definition": { "$ref": "icp.json" },
    "observed_signals_divergence": {
      "type": "object",
      "properties": {
        "divergence_score": { "type": "number" },
        "divergent_traits": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["snapshot_id", "captured_at", "icp_definition"]
}
