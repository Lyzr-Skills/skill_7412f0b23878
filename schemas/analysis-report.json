{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisReportSchema",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "pipeline_version": { "type": "string" }
      }
    },
    "business_context": { "type": "object" },
    "evidence": { "type": "array", "items": { "$ref": "evidence.json" } },
    "signals": { "type": "array", "items": { "$ref": "customer-signal.json" } },
    "segments": { "type": "array", "items": { "$ref": "segment.json" } },
    "primary_icp": { "$ref": "icp.json" },
    "secondary_icp": { "$ref": "icp.json" },
    "negative_icp": { "$ref": "icp.json" },
    "personas": { "type": "array", "items": { "$ref": "persona.json" } },
    "buying_committee": { "type": "array", "items": { "$ref": "buying-role.json" } }
  },
  "required": ["metadata", "business_context", "evidence", "signals", "primary_icp"]
}
