{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomerSignalSchema",
  "type": "object",
  "properties": {
    "signal_id": { "type": "string", "pattern": "^SIG-[0-9]{3}$" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EV-[0-9]{3}$" }
    },
    "pain_category": { "type": "string" },
    "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "adhoc"] },
    "severity": { "type": "string", "enum": ["high", "medium", "low"] },
    "desired_outcome": { "type": "string" }
  },
  "required": ["signal_id", "evidence_refs", "pain_category", "severity"]
}
